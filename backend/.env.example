# ---------- ASSERT CMS (NestJS) ----------
# Port the API/admin listens on. Passenger (cPanel/Plesk/Virtualmin) overrides this automatically.
PORT=4000

# Public URL of this CMS (used for absolute media links shown in the admin).
PUBLIC_URL=http://localhost:4000

# Where the flat-file JSON database and uploaded media are stored.
# Relative paths are resolved from the backend folder. Keep them OUTSIDE public_html on shared hosting.
DATA_DIR=./storage/data
UPLOADS_DIR=./storage/uploads

# Long random string used to sign admin login tokens. CHANGE IN PRODUCTION.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# First admin account – created only when no users exist yet.
ADMIN_EMAIL=admin@assert.gr
ADMIN_PASSWORD=ChangeMe123!

# Public website (Next.js). Used for on-demand cache refresh after edits, CORS and "View site" links.
FRONTEND_URL=http://localhost:3100
# Must match REVALIDATE_SECRET in frontend/.env
REVALIDATE_SECRET=change-me-shared-secret

# Extra comma-separated origins allowed to call the API from a browser (optional).
CORS_ORIGINS=

# Optional: send contact-form notifications to a webhook (e.g. Slack/Teams/Zapier). Leave empty to disable.
CONTACT_WEBHOOK_URL=
