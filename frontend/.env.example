# ---------- ASSERT website (Next.js) ----------
PORT=3100

# Internal URL of the CMS API, reachable from this server (not from browsers).
#   Local dev:       http://localhost:4000
#   Docker:          http://cms:4000
#   cPanel/Plesk:    https://cms.assert.gr  (or http://127.0.0.1:<port> if both apps run on the same machine)
API_URL=http://localhost:4000

# Fallback public URL of the site (the CMS "Public site URL" setting takes priority).
SITE_URL=http://localhost:3100

# Shared secret – must match REVALIDATE_SECRET in backend/.env
REVALIDATE_SECRET=change-me-shared-secret

# Seconds before cached pages are refreshed from the CMS even without an edit.
CMS_REVALIDATE_SECONDS=300
