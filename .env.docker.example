# Copy to ".env" next to docker-compose.yml and change the values.
SITE_URL=http://localhost:3000
CMS_PUBLIC_URL=http://localhost:4000
WEB_PORT=3000
CMS_PORT=4000

# Generate long random values, e.g.:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
REVALIDATE_SECRET=replace-with-another-long-random-string

# First admin account (created on first start only)
ADMIN_EMAIL=admin@assert.gr
ADMIN_PASSWORD=ChangeMe123!

CONTACT_WEBHOOK_URL=
